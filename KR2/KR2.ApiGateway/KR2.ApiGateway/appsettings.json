{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "files-route": {
        "ClusterId": "files-cluster",
        "Match": {
          "Path": "/api/files/{**catch-all}"
        }
      },
      "analysis-route": {
        "ClusterId": "analysis-cluster",
        "Match": {
          "Path": "/api/analysis/{**catch-all}"
        }
      }
    },
    "Clusters": {
      "files-cluster": {
        "Destinations": {
          "files-destination": {
            "Address": "http://file-storing-service:8080"
          }
        }
      },
      "analysis-cluster": {
        "Destinations": {
          "analysis-destination": {
            "Address": "http://file-analysis-service:8080"
          }
        }
      }
    }
  }
}